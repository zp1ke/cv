---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description: string;
  lang?: string;
  appName: string;
}

const { title, description, lang = 'en', appName } = Astro.props;
---

<Layout title={title} description={description} lang={lang}>
  <main class="privacy-page">
    <div class="header">
      <div class="container">
        <p class="title">
          Privacy Policy for {appName}
        </p>
      </div>
    </div>
    <div class="translations-content-container">
      <div class="container">
        <div
          class="tab-content translations-content-item en visible"
          id="en"
        >
          <slot />
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .privacy-page {
    padding-bottom: var(--spacing-xl);
  }

  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--spacing-sm);
  }

  .header {
    margin-top: var(--spacing-lg);
    margin-bottom: var(--spacing-lg);
  }

  .title {
    font-size: 1.5rem;
    font-weight: 700;
  }

  /* Styles for slotted content */
  :global(.privacy-page h1) {
    font-size: 1.875rem;
    font-weight: 700;
    margin: var(--spacing-md) 0;
  }

  :global(.privacy-page h2) {
    font-size: 1.5rem;
    font-weight: 600;
    margin: var(--spacing-md) 0;
    text-align: center;
    color: var(--color-text);
  }

  :global(.privacy-page h3) {
    font-size: 1.125rem;
    font-weight: 600;
    text-align: left;
    margin: var(--spacing-sm) 0;
    color: var(--color-text);
  }

  :global(.privacy-page h4) {
    font-size: 1rem;
    font-weight: 600;
    margin: var(--spacing-sm) 0;
    color: var(--color-text);
  }

  :global(.privacy-page p) {
    font-size: 1rem;
    text-align: justify;
    margin-bottom: var(--spacing-sm);
    color: var(--color-text-secondary);
  }

  :global(.privacy-page .text-sm) {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-md);
  }

  :global(.privacy-page ul) {
    list-style-type: disc;
    list-style-position: outside;
    margin-left: 1.5rem;
    margin-bottom: var(--spacing-md);
  }

  :global(.privacy-page li) {
    margin-bottom: var(--spacing-xs);
  }

  :global(.privacy-page strong) {
    color: var(--color-text);
  }
</style>

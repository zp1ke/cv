---
interface Props {
  profile: {
    name: string;
    title: string;
    location: string;
    email: string;
    phone: string;
    github: string;
    linkedin: string;
  };
  lang: string;
}

const { profile, lang } = Astro.props;
const downloadText = lang === 'es' ? 'Descargar PDF' : 'Download PDF';
const pdfFile = `resume-${lang}.pdf`;
---

<header class="header">
  <div class="header-content">
    <div class="header-main">
      <h1 class="name">{profile.name}</h1>
      <p class="title">{profile.title}</p>
    </div>

    <div class="contact">
      <div class="contact-item">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        <span>{profile.location}</span>
      </div>

      <div class="contact-item">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="4" width="18" height="16" rx="2" ry="2"></rect>
          <polyline points="3,8 12,13 21,8"></polyline>
        </svg>
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
      </div>

      <div class="contact-item">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
        <a href={`tel:${profile.phone}`}>{profile.phone}</a>
      </div>

      <div class="contact-item">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
        </svg>
        <a href={`https://github.com/${profile.github}`} target="_blank" rel="noopener noreferrer">github.com/{profile.github}</a>
      </div>

      <div class="contact-item">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
          <rect x="2" y="9" width="4" height="12"></rect>
          <circle cx="4" cy="4" r="2"></circle>
        </svg>
        <a href={`https://linkedin.com/in/${profile.linkedin}`} target="_blank" rel="noopener noreferrer">linkedin.com/in/{profile.linkedin}</a>
      </div>
    </div>
  </div>

  <div class="header-actions no-print">
    <a href={`/${pdfFile}`} class="btn-download" download>
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
        <polyline points="7 10 12 15 17 10"></polyline>
        <line x1="12" y1="15" x2="12" y2="3"></line>
      </svg>
      {downloadText}
    </a>
  </div>
</header>

<style>
  .header {
    background-color: var(--color-background-secondary);
    border-bottom: 1px solid var(--color-border);
    padding: var(--spacing-lg) var(--spacing-md);
  }

  .header-content {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .header-main {
    margin-bottom: var(--spacing-md);
  }

  .name {
    font-size: 2.5rem;
    margin-bottom: var(--spacing-xs);
    color: var(--color-text);
  }

  .title {
    font-size: 1.25rem;
    color: var(--color-text-secondary);
    font-weight: 500;
  }

  .contact {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--spacing-sm);
  }

  .contact-item {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    color: var(--color-text-secondary);
    font-size: 0.95rem;
  }

  .contact-item svg {
    flex-shrink: 0;
    color: var(--color-accent);
  }

  .header-actions {
    max-width: var(--max-width);
    margin: var(--spacing-md) auto 0;
    display: flex;
    justify-content: flex-end;
  }

  .btn-download {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    padding: var(--spacing-sm) var(--spacing-md);
    background-color: var(--color-accent);
    color: white;
    border-radius: 0.5rem;
    font-weight: 500;
    transition: background-color 0.2s;
    text-decoration: none;
  }

  .btn-download:hover {
    background-color: var(--color-accent-hover);
    text-decoration: none;
  }

  @media (max-width: 768px) {
    .name {
      font-size: 2rem;
    }

    .contact {
      grid-template-columns: 1fr;
    }
  }
</style>

---
interface Props {
  item: {
    title: string;
    company: string;
    location: string;
    dates: string;
    achievements: string[];
  };
}

const { item } = Astro.props;
---

<article class="experience">
  <div class="experience-header">
    <div>
      <h3 class="experience-title">{item.title}</h3>
      <p class="experience-company">{item.company} • {item.location}</p>
    </div>
    <p class="experience-dates">{item.dates}</p>
  </div>
  <ul class="achievements">
    {item.achievements.map((achievement) => (
      <li>{achievement}</li>
    ))}
  </ul>
</article>

<style>
  .experience {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .experience-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--spacing-md);
  }

  .experience-title {
    font-size: 1.25rem;
    color: var(--color-text);
    margin-bottom: 0.25rem;
  }

  .experience-company {
    color: var(--color-text-secondary);
    font-size: 1rem;
  }

  .experience-dates {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    white-space: nowrap;
  }

  .achievements {
    list-style-type: disc;
    padding-left: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .achievements li {
    color: var(--color-text);
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .experience-header {
      flex-direction: column;
      gap: var(--spacing-xs);
    }

    .experience-dates {
      white-space: normal;
    }
  }
</style>
